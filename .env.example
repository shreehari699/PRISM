# ---------------------------------------------------------------------------
# PRISM environment configuration
# Copy this file to .env.local and fill in real values for local development.
# NEVER commit .env.local or any file containing real secrets.
# See ENVIRONMENT.md for full documentation of every variable.
# ---------------------------------------------------------------------------

# --- Supabase (public — safe to expose to the browser) ---------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of this deployment (used for auth redirects, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (server-only — NEVER expose to the browser) ------------------
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (server-only) --------------------------------------------
GEMINI_API_KEY=
# Configurable model id. Change this if a model is deprecated or a newer
# one becomes available — never hard-code a model name in application code.
GEMINI_MODEL=gemini-2.5-flash

# --- Research providers (server-only, all optional) -------------------------
# PRISM never fabricates research. If no provider is configured, the
# research layer reports an explicit "unavailable" state instead of
# inventing sources.
RESEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=

# --- Free-tier usage safety limits (server-only) ----------------------------
# When a limit is reached, PRISM enters safe mode instead of silently
# incurring paid usage. Tune these to match your actual provider quotas.
USAGE_DAILY_AI_REQUEST_LIMIT=50
USAGE_MONTHLY_AI_REQUEST_LIMIT=1000
USAGE_DAILY_RESEARCH_REQUEST_LIMIT=30
